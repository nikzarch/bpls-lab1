{
  "type": "default",
  "id": "payment-process-start",
  "components": [
    {
      "label": "ID существующего заказа (если заказ уже создан)",
      "type": "number",
      "key": "orderId"
    },
    {
      "label": "ID виджета (если нужно создать заказ)",
      "type": "number",
      "key": "widgetId"
    },
    {
      "label": "ID товара (если нужно создать заказ)",
      "type": "number",
      "key": "productId"
    },
    {
      "label": "Способ оплаты",
      "type": "select",
      "key": "method",
      "values": [
        { "label": "Кошелёк", "value": "WALLET" },
        { "label": "Карта", "value": "CARD" }
      ],
      "validate": { "required": true }
    },
    {
      "label": "Токен карты (если карта уже привязана)",
      "type": "textfield",
      "key": "cardToken"
    }
  ]
}