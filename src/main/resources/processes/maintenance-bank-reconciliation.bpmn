<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Labpay" targetNamespace="http://labpay.example.com/bpmn">
  <bpmn:process id="maintenance-bank-reconciliation" name="Сверка банковских операций" isExecutable="true" camunda:historyTimeToLive="30" camunda:candidateStarterGroups="ADMIN">
    <bpmn:startEvent id="maintenance-bank-reconciliation-start" name="Каждые 30 минут">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:outgoing>mbr_flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="maintenance-bank-reconciliation-task" name="Запустить сверку банка" camunda:delegateExpression="${bankReconciliationDelegate}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${camundaProcessStateListener}" />
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>mbr_flow_1</bpmn:incoming>
      <bpmn:outgoing>mbr_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="maintenance-bank-reconciliation-end" name="Запуск принят">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>mbr_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="mbr_flow_1" sourceRef="maintenance-bank-reconciliation-start" targetRef="maintenance-bank-reconciliation-task" />
    <bpmn:sequenceFlow id="mbr_flow_2" sourceRef="maintenance-bank-reconciliation-task" targetRef="maintenance-bank-reconciliation-end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_MaintenanceBank">
    <bpmndi:BPMNPlane id="BPMNPlane_MaintenanceBank" bpmnElement="maintenance-bank-reconciliation">
      <bpmndi:BPMNShape id="maintenance-bank-reconciliation-start_di" bpmnElement="maintenance-bank-reconciliation-start">
        <dc:Bounds x="120" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="maintenance-bank-reconciliation-task_di" bpmnElement="maintenance-bank-reconciliation-task">
        <dc:Bounds x="230" y="98" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="maintenance-bank-reconciliation-end_di" bpmnElement="maintenance-bank-reconciliation-end">
        <dc:Bounds x="480" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="mbr_flow_1_di" bpmnElement="mbr_flow_1">
        <di:waypoint x="156" y="138" />
        <di:waypoint x="230" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mbr_flow_2_di" bpmnElement="mbr_flow_2">
        <di:waypoint x="400" y="138" />
        <di:waypoint x="480" y="138" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>