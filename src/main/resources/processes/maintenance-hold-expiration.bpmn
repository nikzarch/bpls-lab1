<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Labpay" targetNamespace="http://labpay.example.com/bpmn">
  <bpmn:process id="maintenance-hold-expiration" name="Истечение холдов" isExecutable="true" camunda:historyTimeToLive="30" camunda:candidateStarterGroups="ADMIN">
    <bpmn:startEvent id="maintenance-hold-expiration-start" name="Каждые 15 минут">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:outgoing>mhe_flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="maintenance-hold-expiration-task" name="Запустить истечение холдов" camunda:delegateExpression="${holdExpirationDelegate}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${camundaProcessStateListener}" />
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>mhe_flow_1</bpmn:incoming>
      <bpmn:outgoing>mhe_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="maintenance-hold-expiration-end" name="Запуск принят">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>mhe_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="mhe_flow_1" sourceRef="maintenance-hold-expiration-start" targetRef="maintenance-hold-expiration-task" />
    <bpmn:sequenceFlow id="mhe_flow_2" sourceRef="maintenance-hold-expiration-task" targetRef="maintenance-hold-expiration-end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_MaintenanceHold">
    <bpmndi:BPMNPlane id="BPMNPlane_MaintenanceHold" bpmnElement="maintenance-hold-expiration">
      <bpmndi:BPMNShape id="maintenance-hold-expiration-start_di" bpmnElement="maintenance-hold-expiration-start">
        <dc:Bounds x="120" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="maintenance-hold-expiration-task_di" bpmnElement="maintenance-hold-expiration-task">
        <dc:Bounds x="230" y="98" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="maintenance-hold-expiration-end_di" bpmnElement="maintenance-hold-expiration-end">
        <dc:Bounds x="480" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="mhe_flow_1_di" bpmnElement="mhe_flow_1">
        <di:waypoint x="156" y="138" />
        <di:waypoint x="230" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mhe_flow_2_di" bpmnElement="mhe_flow_2">
        <di:waypoint x="400" y="138" />
        <di:waypoint x="480" y="138" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>