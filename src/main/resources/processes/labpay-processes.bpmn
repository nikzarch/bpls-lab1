<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_Labpay"
                  targetNamespace="http://labpay.example.com/bpmn"
                  exporter="bpmn-js (https://demo.bpmn.io)"
                  exporterVersion="17.0.0">

  <bpmn:collaboration id="Collaboration_Labpay">
    <bpmn:participant id="Participant_CardBinding" name="Привязка карты" processRef="card-binding-process" />
    <bpmn:participant id="Participant_PaymentCreate" name="Создание платежа" processRef="payment-create-process" />
    <bpmn:participant id="Participant_PaymentProcess" name="Проведение платежа" processRef="payment-process" />
    <bpmn:participant id="Participant_Transfer" name="Перевод" processRef="transfer-process" />
    <bpmn:participant id="Participant_WalletTopUp" name="Пополнение кошелька" processRef="wallet-top-up-process" />
    <bpmn:participant id="Participant_MaintenanceBank" name="Сверка банка" processRef="maintenance-bank-reconciliation" />
    <bpmn:participant id="Participant_MaintenanceHold" name="Истечение холдов" processRef="maintenance-hold-expiration" />
    <bpmn:participant id="Participant_MaintenanceCard" name="Очистка 3DS-сессий" processRef="maintenance-card-session-cleanup" />
    <bpmn:participant id="Participant_MaintenanceTransfer" name="Зависшие переводы" processRef="maintenance-stuck-transfer" />
  </bpmn:collaboration>

  <bpmn:process id="card-binding-process" name="Привязка карты" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="CardBinding_Start" name="Ввести реквизиты" camunda:formRef="card-binding-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>CardBinding_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="CardBinding_CheckCard" name="Проверить карту и создать 3DS-сессию" camunda:delegateExpression="${cardBindingStartDelegate}">
      <bpmn:incoming>CardBinding_Flow_1</bpmn:incoming>
      <bpmn:outgoing>CardBinding_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CardBinding_Gateway_Requires3ds" name="Нужен 3DS?">
      <bpmn:incoming>CardBinding_Flow_2</bpmn:incoming>
      <bpmn:outgoing>CardBinding_Flow_3_Yes</bpmn:outgoing>
      <bpmn:outgoing>CardBinding_Flow_3_No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="CardBinding_Confirm3ds" name="Подтвердить 3DS" camunda:formRef="card-binding-confirm" camunda:formRefBinding="deployment">
      <bpmn:incoming>CardBinding_Flow_3_Yes</bpmn:incoming>
      <bpmn:outgoing>CardBinding_Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="CardBinding_3dsTimeout" name="Таймаут 5 минут" attachedToRef="CardBinding_Confirm3ds" cancelActivity="true">
      <bpmn:outgoing>CardBinding_Flow_Timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="CardBinding_SaveCard" name="Завершить привязку карты" camunda:delegateExpression="${cardBindingConfirmDelegate}">
      <bpmn:incoming>CardBinding_Flow_4</bpmn:incoming>
      <bpmn:outgoing>CardBinding_Flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="CardBinding_End_No3ds" name="Карта привязана">
      <bpmn:incoming>CardBinding_Flow_3_No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CardBinding_End_Success" name="Карта привязана">
      <bpmn:incoming>CardBinding_Flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="CardBinding_End_Timeout" name="Ошибка привязки: 3DS timeout">
      <bpmn:incoming>CardBinding_Flow_Timeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="CardBinding_Flow_1" sourceRef="CardBinding_Start" targetRef="CardBinding_CheckCard" />
    <bpmn:sequenceFlow id="CardBinding_Flow_2" sourceRef="CardBinding_CheckCard" targetRef="CardBinding_Gateway_Requires3ds" />
    <bpmn:sequenceFlow id="CardBinding_Flow_3_Yes" name="Да" sourceRef="CardBinding_Gateway_Requires3ds" targetRef="CardBinding_Confirm3ds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requires3ds == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CardBinding_Flow_3_No" name="Нет" sourceRef="CardBinding_Gateway_Requires3ds" targetRef="CardBinding_End_No3ds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requires3ds == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CardBinding_Flow_4" sourceRef="CardBinding_Confirm3ds" targetRef="CardBinding_SaveCard" />
    <bpmn:sequenceFlow id="CardBinding_Flow_5" sourceRef="CardBinding_SaveCard" targetRef="CardBinding_End_Success" />
    <bpmn:sequenceFlow id="CardBinding_Flow_Timeout" sourceRef="CardBinding_3dsTimeout" targetRef="CardBinding_End_Timeout" />
  </bpmn:process>

  <bpmn:process id="payment-create-process" name="Создание заказа оплаты" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="PaymentCreate_Start" name="Параметры заказа" camunda:formRef="payment-create-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>PaymentCreate_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PaymentCreate_CreateOrder" name="Создать заказ оплаты" camunda:delegateExpression="${paymentCreateDelegate}">
      <bpmn:incoming>PaymentCreate_Flow_1</bpmn:incoming>
      <bpmn:outgoing>PaymentCreate_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="PaymentCreate_End" name="Заказ создан">
      <bpmn:incoming>PaymentCreate_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PaymentCreate_Flow_1" sourceRef="PaymentCreate_Start" targetRef="PaymentCreate_CreateOrder" />
    <bpmn:sequenceFlow id="PaymentCreate_Flow_2" sourceRef="PaymentCreate_CreateOrder" targetRef="PaymentCreate_End" />
  </bpmn:process>

  <bpmn:process id="payment-process" name="Проведение платежа" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="PaymentProcess_Start" name="Выбор способа оплаты" camunda:formRef="payment-process-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>PaymentProcess_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="PaymentProcess_ProcessPayment" name="Провести оплату" camunda:delegateExpression="${paymentProcessDelegate}">
      <bpmn:incoming>PaymentProcess_Flow_1</bpmn:incoming>
      <bpmn:outgoing>PaymentProcess_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="PaymentProcess_Gateway_Status" name="Оплачено?">
      <bpmn:incoming>PaymentProcess_Flow_2</bpmn:incoming>
      <bpmn:outgoing>PaymentProcess_Flow_Paid</bpmn:outgoing>
      <bpmn:outgoing>PaymentProcess_Flow_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="PaymentProcess_End_Paid" name="Оплата завершена">
      <bpmn:incoming>PaymentProcess_Flow_Paid</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="PaymentProcess_End_Failed" name="Оплата не завершена">
      <bpmn:incoming>PaymentProcess_Flow_Failed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="PaymentProcess_Flow_1" sourceRef="PaymentProcess_Start" targetRef="PaymentProcess_ProcessPayment" />
    <bpmn:sequenceFlow id="PaymentProcess_Flow_2" sourceRef="PaymentProcess_ProcessPayment" targetRef="PaymentProcess_Gateway_Status" />
    <bpmn:sequenceFlow id="PaymentProcess_Flow_Paid" name="PAID" sourceRef="PaymentProcess_Gateway_Status" targetRef="PaymentProcess_End_Paid">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentStatus == 'PAID'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="PaymentProcess_Flow_Failed" name="Не PAID" sourceRef="PaymentProcess_Gateway_Status" targetRef="PaymentProcess_End_Failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentStatus != 'PAID'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmn:process id="transfer-process" name="Перевод" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="Transfer_Start" name="Параметры перевода" camunda:formRef="transfer-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>Transfer_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Transfer_DoTransfer" name="Выполнить перевод" camunda:delegateExpression="${transferDelegate}">
      <bpmn:incoming>Transfer_Flow_1</bpmn:incoming>
      <bpmn:outgoing>Transfer_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Transfer_Gateway_Status" name="Перевод успешен?">
      <bpmn:incoming>Transfer_Flow_2</bpmn:incoming>
      <bpmn:outgoing>Transfer_Flow_Success</bpmn:outgoing>
      <bpmn:outgoing>Transfer_Flow_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Transfer_End_Success" name="Перевод завершён">
      <bpmn:incoming>Transfer_Flow_Success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="Transfer_End_Failed" name="Перевод не завершён">
      <bpmn:incoming>Transfer_Flow_Failed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Transfer_Flow_1" sourceRef="Transfer_Start" targetRef="Transfer_DoTransfer" />
    <bpmn:sequenceFlow id="Transfer_Flow_2" sourceRef="Transfer_DoTransfer" targetRef="Transfer_Gateway_Status" />
    <bpmn:sequenceFlow id="Transfer_Flow_Success" name="SUCCESS" sourceRef="Transfer_Gateway_Status" targetRef="Transfer_End_Success">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferStatus == 'SUCCESS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Transfer_Flow_Failed" name="Не SUCCESS" sourceRef="Transfer_Gateway_Status" targetRef="Transfer_End_Failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferStatus != 'SUCCESS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmn:process id="wallet-top-up-process" name="Пополнение кошелька" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="WalletTopUp_Start" name="Параметры пополнения" camunda:formRef="wallet-top-up-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>WalletTopUp_Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="WalletTopUp_DoTopUp" name="Выполнить пополнение" camunda:delegateExpression="${walletTopUpDelegate}">
      <bpmn:incoming>WalletTopUp_Flow_1</bpmn:incoming>
      <bpmn:outgoing>WalletTopUp_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="WalletTopUp_End" name="Пополнение принято">
      <bpmn:incoming>WalletTopUp_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="WalletTopUp_Flow_1" sourceRef="WalletTopUp_Start" targetRef="WalletTopUp_DoTopUp" />
    <bpmn:sequenceFlow id="WalletTopUp_Flow_2" sourceRef="WalletTopUp_DoTopUp" targetRef="WalletTopUp_End" />
  </bpmn:process>

  <bpmn:process id="maintenance-bank-reconciliation" name="Сверка банковских операций" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="MaintenanceBank_Start" name="Каждые 30 минут">
      <bpmn:outgoing>MaintenanceBank_Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="MaintenanceBank_Run" name="Запустить сверку банка" camunda:delegateExpression="${bankReconciliationDelegate}">
      <bpmn:incoming>MaintenanceBank_Flow_1</bpmn:incoming>
      <bpmn:outgoing>MaintenanceBank_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="MaintenanceBank_End" name="Запуск принят">
      <bpmn:incoming>MaintenanceBank_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MaintenanceBank_Flow_1" sourceRef="MaintenanceBank_Start" targetRef="MaintenanceBank_Run" />
    <bpmn:sequenceFlow id="MaintenanceBank_Flow_2" sourceRef="MaintenanceBank_Run" targetRef="MaintenanceBank_End" />
  </bpmn:process>

  <bpmn:process id="maintenance-hold-expiration" name="Истечение холдов" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="MaintenanceHold_Start" name="Каждые 15 минут">
      <bpmn:outgoing>MaintenanceHold_Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="MaintenanceHold_Run" name="Запустить истечение холдов" camunda:delegateExpression="${holdExpirationDelegate}">
      <bpmn:incoming>MaintenanceHold_Flow_1</bpmn:incoming>
      <bpmn:outgoing>MaintenanceHold_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="MaintenanceHold_End" name="Запуск принят">
      <bpmn:incoming>MaintenanceHold_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MaintenanceHold_Flow_1" sourceRef="MaintenanceHold_Start" targetRef="MaintenanceHold_Run" />
    <bpmn:sequenceFlow id="MaintenanceHold_Flow_2" sourceRef="MaintenanceHold_Run" targetRef="MaintenanceHold_End" />
  </bpmn:process>

  <bpmn:process id="maintenance-card-session-cleanup" name="Очистка 3DS-сессий" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="MaintenanceCard_Start" name="Каждый час">
      <bpmn:outgoing>MaintenanceCard_Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="MaintenanceCard_Run" name="Запустить очистку 3DS-сессий" camunda:delegateExpression="${cardSessionCleanupDelegate}">
      <bpmn:incoming>MaintenanceCard_Flow_1</bpmn:incoming>
      <bpmn:outgoing>MaintenanceCard_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="MaintenanceCard_End" name="Запуск принят">
      <bpmn:incoming>MaintenanceCard_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MaintenanceCard_Flow_1" sourceRef="MaintenanceCard_Start" targetRef="MaintenanceCard_Run" />
    <bpmn:sequenceFlow id="MaintenanceCard_Flow_2" sourceRef="MaintenanceCard_Run" targetRef="MaintenanceCard_End" />
  </bpmn:process>

  <bpmn:process id="maintenance-stuck-transfer" name="Обработка зависших переводов" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="MaintenanceTransfer_Start" name="Каждые 10 минут">
      <bpmn:outgoing>MaintenanceTransfer_Flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT10M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="MaintenanceTransfer_Run" name="Запустить обработку зависших переводов" camunda:delegateExpression="${stuckTransferDelegate}">
      <bpmn:incoming>MaintenanceTransfer_Flow_1</bpmn:incoming>
      <bpmn:outgoing>MaintenanceTransfer_Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="MaintenanceTransfer_End" name="Запуск принят">
      <bpmn:incoming>MaintenanceTransfer_Flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="MaintenanceTransfer_Flow_1" sourceRef="MaintenanceTransfer_Start" targetRef="MaintenanceTransfer_Run" />
    <bpmn:sequenceFlow id="MaintenanceTransfer_Flow_2" sourceRef="MaintenanceTransfer_Run" targetRef="MaintenanceTransfer_End" />
  </bpmn:process>

  <bpmndi:BPMNDiagram id="BPMNDiagram_Labpay">
    <bpmndi:BPMNPlane id="BPMNPlane_Labpay" bpmnElement="Collaboration_Labpay">

      <bpmndi:BPMNShape id="Participant_CardBinding_di" bpmnElement="Participant_CardBinding" isHorizontal="true"><dc:Bounds x="100" y="80" width="1040" height="180" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardBinding_Start_di" bpmnElement="CardBinding_Start"><dc:Bounds x="170" y="152" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardBinding_CheckCard_di" bpmnElement="CardBinding_CheckCard"><dc:Bounds x="260" y="130" width="180" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardBinding_Gateway_Requires3ds_di" bpmnElement="CardBinding_Gateway_Requires3ds" isMarkerVisible="true"><dc:Bounds x="500" y="145" width="50" height="50" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardBinding_Confirm3ds_di" bpmnElement="CardBinding_Confirm3ds"><dc:Bounds x="620" y="130" width="140" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardBinding_3dsTimeout_di" bpmnElement="CardBinding_3dsTimeout"><dc:Bounds x="704" y="192" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardBinding_SaveCard_di" bpmnElement="CardBinding_SaveCard"><dc:Bounds x="820" y="130" width="150" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardBinding_End_No3ds_di" bpmnElement="CardBinding_End_No3ds"><dc:Bounds x="672" y="100" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardBinding_End_Success_di" bpmnElement="CardBinding_End_Success"><dc:Bounds x="1040" y="152" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CardBinding_End_Timeout_di" bpmnElement="CardBinding_End_Timeout"><dc:Bounds x="1040" y="212" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="CardBinding_Flow_1_di" bpmnElement="CardBinding_Flow_1"><di:waypoint x="206" y="170" /><di:waypoint x="260" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CardBinding_Flow_2_di" bpmnElement="CardBinding_Flow_2"><di:waypoint x="440" y="170" /><di:waypoint x="500" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CardBinding_Flow_3_Yes_di" bpmnElement="CardBinding_Flow_3_Yes"><di:waypoint x="550" y="170" /><di:waypoint x="620" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CardBinding_Flow_3_No_di" bpmnElement="CardBinding_Flow_3_No"><di:waypoint x="525" y="145" /><di:waypoint x="525" y="118" /><di:waypoint x="672" y="118" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CardBinding_Flow_4_di" bpmnElement="CardBinding_Flow_4"><di:waypoint x="760" y="170" /><di:waypoint x="820" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CardBinding_Flow_5_di" bpmnElement="CardBinding_Flow_5"><di:waypoint x="970" y="170" /><di:waypoint x="1040" y="170" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="CardBinding_Flow_Timeout_di" bpmnElement="CardBinding_Flow_Timeout"><di:waypoint x="722" y="228" /><di:waypoint x="722" y="230" /><di:waypoint x="1040" y="230" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_PaymentCreate_di" bpmnElement="Participant_PaymentCreate" isHorizontal="true"><dc:Bounds x="100" y="300" width="640" height="130" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentCreate_Start_di" bpmnElement="PaymentCreate_Start"><dc:Bounds x="170" y="347" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentCreate_CreateOrder_di" bpmnElement="PaymentCreate_CreateOrder"><dc:Bounds x="280" y="325" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentCreate_End_di" bpmnElement="PaymentCreate_End"><dc:Bounds x="540" y="347" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="PaymentCreate_Flow_1_di" bpmnElement="PaymentCreate_Flow_1"><di:waypoint x="206" y="365" /><di:waypoint x="280" y="365" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="PaymentCreate_Flow_2_di" bpmnElement="PaymentCreate_Flow_2"><di:waypoint x="440" y="365" /><di:waypoint x="540" y="365" /></bpmndi:BPMNEdge>

      <bpmndi:BPMNShape id="Participant_PaymentProcess_di" bpmnElement="Participant_PaymentProcess" isHorizontal="true"><dc:Bounds x="100" y="470" width="800" height="150" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentProcess_Start_di" bpmnElement="PaymentProcess_Start"><dc:Bounds x="170" y="527" width="36" height="36" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentProcess_ProcessPayment_di" bpmnElement="PaymentProcess_ProcessPayment"><dc:Bounds x="280" y="505" width="160" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="PaymentProcess_Gateway_Status_di" bpmnElement="PaymentProcess_Gateway_Status" isMarkerVisible="true"><dc:Bounds x="510" y="520" width="50" height="50" /></bpmndi:BPMNShape>
