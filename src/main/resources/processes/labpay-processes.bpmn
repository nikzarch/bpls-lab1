<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
    xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
    xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
    xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
    xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
    id="Definitions_Labpay"
    targetNamespace="http://labpay.example.com/bpmn">

  <bpmn:process id="payment-process" name="Проведение платежа" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="payment-process-start" name="Старт оплаты" camunda:formRef="payment-process-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>pp_flow_start_to_has_order</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:exclusiveGateway id="pp_has_order_gateway" name="Заказ уже создан?">
      <bpmn:incoming>pp_flow_start_to_has_order</bpmn:incoming>
      <bpmn:outgoing>pp_flow_has_order_yes</bpmn:outgoing>
      <bpmn:outgoing>pp_flow_has_order_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="pp_create_order_task" name="Создать заказ оплаты" camunda:delegateExpression="${paymentCreateDelegate}">
      <bpmn:incoming>pp_flow_has_order_no</bpmn:incoming>
      <bpmn:outgoing>pp_flow_created_to_method</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="pp_method_gateway" name="Способ оплаты">
      <bpmn:incoming>pp_flow_has_order_yes</bpmn:incoming>
      <bpmn:incoming>pp_flow_created_to_method</bpmn:incoming>
      <bpmn:outgoing>pp_flow_method_wallet</bpmn:outgoing>
      <bpmn:outgoing>pp_flow_method_card</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:exclusiveGateway id="pp_card_token_gateway" name="Карта уже привязана?">
      <bpmn:incoming>pp_flow_method_card</bpmn:incoming>
      <bpmn:outgoing>pp_flow_card_token_yes</bpmn:outgoing>
      <bpmn:outgoing>pp_flow_card_token_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="pp_enter_card_details_task" name="Ввести реквизиты карты" camunda:formRef="card-binding-start" camunda:formRefBinding="deployment">
      <bpmn:incoming>pp_flow_card_token_no</bpmn:incoming>
      <bpmn:outgoing>pp_flow_card_details_to_bind</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:serviceTask id="pp_bind_card_task" name="Проверить карту и создать 3DS-сессию" camunda:delegateExpression="${cardBindingStartDelegate}">
      <bpmn:incoming>pp_flow_card_details_to_bind</bpmn:incoming>
      <bpmn:outgoing>pp_flow_bind_to_requires_3ds</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="pp_requires_3ds_gateway" name="Нужен 3DS?">
      <bpmn:incoming>pp_flow_bind_to_requires_3ds</bpmn:incoming>
      <bpmn:outgoing>pp_flow_requires_3ds_yes</bpmn:outgoing>
      <bpmn:outgoing>pp_flow_requires_3ds_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:userTask id="pp_card_binding_confirm_task" name="Подтвердить 3DS" camunda:formRef="card-binding-confirm" camunda:formRefBinding="deployment">
      <bpmn:incoming>pp_flow_requires_3ds_yes</bpmn:incoming>
      <bpmn:outgoing>pp_flow_confirm_to_finish_bind</bpmn:outgoing>
    </bpmn:userTask>

    <bpmn:boundaryEvent id="pp_card_binding_3ds_timeout" name="Таймаут 5 минут" attachedToRef="pp_card_binding_confirm_task" cancelActivity="true">
      <bpmn:outgoing>pp_flow_3ds_timeout_to_error</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>

    <bpmn:serviceTask id="pp_finish_card_binding_task" name="Завершить привязку карты" camunda:delegateExpression="${cardBindingConfirmDelegate}">
      <bpmn:incoming>pp_flow_confirm_to_finish_bind</bpmn:incoming>
      <bpmn:outgoing>pp_flow_finished_bind_to_process_payment</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="pp_process_payment_task" name="Провести оплату" camunda:delegateExpression="${paymentProcessDelegate}">
      <bpmn:incoming>pp_flow_method_wallet</bpmn:incoming>
      <bpmn:incoming>pp_flow_card_token_yes</bpmn:incoming>
      <bpmn:incoming>pp_flow_requires_3ds_no</bpmn:incoming>
      <bpmn:incoming>pp_flow_finished_bind_to_process_payment</bpmn:incoming>
      <bpmn:outgoing>pp_flow_process_to_status</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:exclusiveGateway id="pp_payment_status_gateway" name="Оплачено?">
      <bpmn:incoming>pp_flow_process_to_status</bpmn:incoming>
      <bpmn:outgoing>pp_flow_paid</bpmn:outgoing>
      <bpmn:outgoing>pp_flow_failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="pp_notify_merchant_task" name="Webhook продавцу / Bitrix CRM" camunda:expression="${true}">
      <bpmn:incoming>pp_flow_paid</bpmn:incoming>
      <bpmn:outgoing>pp_flow_notify_to_success</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="pp_success_end" name="Оплата завершена">
      <bpmn:incoming>pp_flow_notify_to_success</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="pp_failed_end" name="Оплата не завершена">
      <bpmn:incoming>pp_flow_failed</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="pp_3ds_timeout_end" name="Ошибка: 3DS timeout">
      <bpmn:incoming>pp_flow_3ds_timeout_to_error</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="pp_flow_start_to_has_order" sourceRef="payment-process-start" targetRef="pp_has_order_gateway" />
    <bpmn:sequenceFlow id="pp_flow_has_order_yes" name="Да" sourceRef="pp_has_order_gateway" targetRef="pp_method_gateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderId != null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_has_order_no" name="Нет" sourceRef="pp_has_order_gateway" targetRef="pp_create_order_task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${orderId == null}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_created_to_method" sourceRef="pp_create_order_task" targetRef="pp_method_gateway" />
    <bpmn:sequenceFlow id="pp_flow_method_wallet" name="Кошелёк" sourceRef="pp_method_gateway" targetRef="pp_process_payment_task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${method != 'CARD'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_method_card" name="Карта" sourceRef="pp_method_gateway" targetRef="pp_card_token_gateway">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${method == 'CARD'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_card_token_yes" name="Да" sourceRef="pp_card_token_gateway" targetRef="pp_process_payment_task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cardToken != null and cardToken != ''}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_card_token_no" name="Нет" sourceRef="pp_card_token_gateway" targetRef="pp_enter_card_details_task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${cardToken == null or cardToken == ''}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_card_details_to_bind" sourceRef="pp_enter_card_details_task" targetRef="pp_bind_card_task" />
    <bpmn:sequenceFlow id="pp_flow_bind_to_requires_3ds" sourceRef="pp_bind_card_task" targetRef="pp_requires_3ds_gateway" />
    <bpmn:sequenceFlow id="pp_flow_requires_3ds_yes" name="Да" sourceRef="pp_requires_3ds_gateway" targetRef="pp_card_binding_confirm_task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requires3ds == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_requires_3ds_no" name="Нет" sourceRef="pp_requires_3ds_gateway" targetRef="pp_process_payment_task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requires3ds == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_confirm_to_finish_bind" sourceRef="pp_card_binding_confirm_task" targetRef="pp_finish_card_binding_task" />
    <bpmn:sequenceFlow id="pp_flow_finished_bind_to_process_payment" sourceRef="pp_finish_card_binding_task" targetRef="pp_process_payment_task" />
    <bpmn:sequenceFlow id="pp_flow_process_to_status" sourceRef="pp_process_payment_task" targetRef="pp_payment_status_gateway" />
    <bpmn:sequenceFlow id="pp_flow_paid" name="PAID" sourceRef="pp_payment_status_gateway" targetRef="pp_notify_merchant_task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentStatus == 'PAID'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_failed" name="Не PAID" sourceRef="pp_payment_status_gateway" targetRef="pp_failed_end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${paymentStatus != 'PAID'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="pp_flow_notify_to_success" sourceRef="pp_notify_merchant_task" targetRef="pp_success_end" />
    <bpmn:sequenceFlow id="pp_flow_3ds_timeout_to_error" sourceRef="pp_card_binding_3ds_timeout" targetRef="pp_3ds_timeout_end" />
  </bpmn:process>

  <bpmn:process id="card-binding-process" name="Привязка карты" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="card-binding-start" name="Старт привязки" camunda:formRef="card-binding-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>cb_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="card-binding-start-task" name="Проверить карту и создать 3DS-сессию" camunda:delegateExpression="${cardBindingStartDelegate}">
      <bpmn:incoming>cb_flow_1</bpmn:incoming>
      <bpmn:outgoing>cb_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="card-binding-requires-3ds" name="Нужен 3DS?">
      <bpmn:incoming>cb_flow_2</bpmn:incoming>
      <bpmn:outgoing>cb_flow_3_yes</bpmn:outgoing>
      <bpmn:outgoing>cb_flow_3_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="card-binding-confirm-task" name="Подтвердить 3DS" camunda:formRef="card-binding-confirm" camunda:formRefBinding="deployment">
      <bpmn:incoming>cb_flow_3_yes</bpmn:incoming>
      <bpmn:outgoing>cb_flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="card-binding-3ds-timeout" name="Таймаут 5 минут" attachedToRef="card-binding-confirm-task" cancelActivity="true">
      <bpmn:outgoing>cb_flow_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="card-binding-confirm-service" name="Завершить привязку карты" camunda:delegateExpression="${cardBindingConfirmDelegate}">
      <bpmn:incoming>cb_flow_4</bpmn:incoming>
      <bpmn:outgoing>cb_flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="card-binding-end-no-3ds" name="Карта привязана">
      <bpmn:incoming>cb_flow_3_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="card-binding-end" name="Карта привязана">
      <bpmn:incoming>cb_flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="card-binding-end-timeout" name="Ошибка привязки: 3DS timeout">
      <bpmn:incoming>cb_flow_timeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="cb_flow_1" sourceRef="card-binding-start" targetRef="card-binding-start-task" />
    <bpmn:sequenceFlow id="cb_flow_2" sourceRef="card-binding-start-task" targetRef="card-binding-requires-3ds" />
    <bpmn:sequenceFlow id="cb_flow_3_yes" name="Да" sourceRef="card-binding-requires-3ds" targetRef="card-binding-confirm-task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requires3ds == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="cb_flow_3_no" name="Нет" sourceRef="card-binding-requires-3ds" targetRef="card-binding-end-no-3ds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requires3ds == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="cb_flow_4" sourceRef="card-binding-confirm-task" targetRef="card-binding-confirm-service" />
    <bpmn:sequenceFlow id="cb_flow_5" sourceRef="card-binding-confirm-service" targetRef="card-binding-end" />
    <bpmn:sequenceFlow id="cb_flow_timeout" sourceRef="card-binding-3ds-timeout" targetRef="card-binding-end-timeout" />
  </bpmn:process>

  <bpmn:process id="payment-create-process" name="Создание заказа оплаты" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="payment-create-process-start" name="Параметры заказа" camunda:formRef="payment-create-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>pc_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="payment-create-task" name="Создать заказ оплаты" camunda:delegateExpression="${paymentCreateDelegate}">
      <bpmn:incoming>pc_flow_1</bpmn:incoming>
      <bpmn:outgoing>pc_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="payment-create-process-end" name="Заказ создан">
      <bpmn:incoming>pc_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="pc_flow_1" sourceRef="payment-create-process-start" targetRef="payment-create-task" />
    <bpmn:sequenceFlow id="pc_flow_2" sourceRef="payment-create-task" targetRef="payment-create-process-end" />
  </bpmn:process>

  <bpmn:process id="transfer-process" name="Перевод" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="transfer-process-start" name="Параметры перевода" camunda:formRef="transfer-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>tr_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="transfer-task" name="Выполнить перевод" camunda:delegateExpression="${transferDelegate}">
      <bpmn:incoming>tr_flow_1</bpmn:incoming>
      <bpmn:outgoing>tr_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="transfer-status-gateway" name="Перевод успешен?">
      <bpmn:incoming>tr_flow_2</bpmn:incoming>
      <bpmn:outgoing>tr_flow_success</bpmn:outgoing>
      <bpmn:outgoing>tr_flow_failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="transfer-process-end" name="Перевод завершён">
      <bpmn:incoming>tr_flow_success</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="transfer-process-end-failed" name="Перевод не завершён">
      <bpmn:incoming>tr_flow_failed</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="tr_flow_1" sourceRef="transfer-process-start" targetRef="transfer-task" />
    <bpmn:sequenceFlow id="tr_flow_2" sourceRef="transfer-task" targetRef="transfer-status-gateway" />
    <bpmn:sequenceFlow id="tr_flow_success" name="SUCCESS" sourceRef="transfer-status-gateway" targetRef="transfer-process-end">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferStatus == 'SUCCESS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="tr_flow_failed" name="Не SUCCESS" sourceRef="transfer-status-gateway" targetRef="transfer-process-end-failed">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${transferStatus != 'SUCCESS'}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
  </bpmn:process>

  <bpmn:process id="wallet-top-up-process" name="Пополнение кошелька" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="wallet-top-up-process-start" name="Параметры пополнения" camunda:formRef="wallet-top-up-start" camunda:formRefBinding="deployment">
      <bpmn:outgoing>wu_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="wallet-top-up-task" name="Выполнить пополнение" camunda:delegateExpression="${walletTopUpDelegate}">
      <bpmn:incoming>wu_flow_1</bpmn:incoming>
      <bpmn:outgoing>wu_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="wallet-top-up-process-end" name="Пополнение принято">
      <bpmn:incoming>wu_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="wu_flow_1" sourceRef="wallet-top-up-process-start" targetRef="wallet-top-up-task" />
    <bpmn:sequenceFlow id="wu_flow_2" sourceRef="wallet-top-up-task" targetRef="wallet-top-up-process-end" />
  </bpmn:process>

  <bpmn:process id="maintenance-bank-reconciliation" name="Сверка банковских операций" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="maintenance-bank-reconciliation-start" name="Каждые 30 минут">
      <bpmn:outgoing>mbr_flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT30M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="maintenance-bank-reconciliation-task" name="Запустить сверку банка" camunda:delegateExpression="${bankReconciliationDelegate}">
      <bpmn:incoming>mbr_flow_1</bpmn:incoming>
      <bpmn:outgoing>mbr_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="maintenance-bank-reconciliation-end" name="Запуск принят">
      <bpmn:incoming>mbr_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="mbr_flow_1" sourceRef="maintenance-bank-reconciliation-start" targetRef="maintenance-bank-reconciliation-task" />
    <bpmn:sequenceFlow id="mbr_flow_2" sourceRef="maintenance-bank-reconciliation-task" targetRef="maintenance-bank-reconciliation-end" />
  </bpmn:process>

  <bpmn:process id="maintenance-hold-expiration" name="Истечение холдов" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="maintenance-hold-expiration-start" name="Каждые 15 минут">
      <bpmn:outgoing>mhe_flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT15M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="maintenance-hold-expiration-task" name="Запустить истечение холдов" camunda:delegateExpression="${holdExpirationDelegate}">
      <bpmn:incoming>mhe_flow_1</bpmn:incoming>
      <bpmn:outgoing>mhe_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="maintenance-hold-expiration-end" name="Запуск принят">
      <bpmn:incoming>mhe_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="mhe_flow_1" sourceRef="maintenance-hold-expiration-start" targetRef="maintenance-hold-expiration-task" />
    <bpmn:sequenceFlow id="mhe_flow_2" sourceRef="maintenance-hold-expiration-task" targetRef="maintenance-hold-expiration-end" />
  </bpmn:process>

  <bpmn:process id="maintenance-card-session-cleanup" name="Очистка 3DS-сессий" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="maintenance-card-session-cleanup-start" name="Каждый час">
      <bpmn:outgoing>mcs_flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="maintenance-card-session-cleanup-task" name="Запустить очистку 3DS-сессий" camunda:delegateExpression="${cardSessionCleanupDelegate}">
      <bpmn:incoming>mcs_flow_1</bpmn:incoming>
      <bpmn:outgoing>mcs_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="maintenance-card-session-cleanup-end" name="Запуск принят">
      <bpmn:incoming>mcs_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="mcs_flow_1" sourceRef="maintenance-card-session-cleanup-start" targetRef="maintenance-card-session-cleanup-task" />
    <bpmn:sequenceFlow id="mcs_flow_2" sourceRef="maintenance-card-session-cleanup-task" targetRef="maintenance-card-session-cleanup-end" />
  </bpmn:process>

  <bpmn:process id="maintenance-stuck-transfer" name="Обработка зависших переводов" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="maintenance-stuck-transfer-start" name="Каждые 10 минут">
      <bpmn:outgoing>mst_flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT10M</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="maintenance-stuck-transfer-task" name="Запустить обработку зависших переводов" camunda:delegateExpression="${stuckTransferDelegate}">
      <bpmn:incoming>mst_flow_1</bpmn:incoming>
      <bpmn:outgoing>mst_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="maintenance-stuck-transfer-end" name="Запуск принят">
      <bpmn:incoming>mst_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="mst_flow_1" sourceRef="maintenance-stuck-transfer-start" targetRef="maintenance-stuck-transfer-task" />
    <bpmn:sequenceFlow id="mst_flow_2" sourceRef="maintenance-stuck-transfer-task" targetRef="maintenance-stuck-transfer-end" />
  </bpmn:process>

