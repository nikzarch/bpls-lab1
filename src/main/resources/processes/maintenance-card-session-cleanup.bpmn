<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Labpay" targetNamespace="http://labpay.example.com/bpmn">
  <bpmn:process id="maintenance-card-session-cleanup" name="Очистка 3DS-сессий" isExecutable="true" camunda:historyTimeToLive="30" camunda:candidateStarterGroups="ADMIN">
    <bpmn:startEvent id="maintenance-card-session-cleanup-start" name="Каждый час">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:outgoing>mcs_flow_1</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeCycle xsi:type="bpmn:tFormalExpression">R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:startEvent>
    <bpmn:serviceTask id="maintenance-card-session-cleanup-task" name="Запустить очистку 3DS-сессий" camunda:delegateExpression="${cardSessionCleanupDelegate}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${camundaProcessStateListener}" />
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>mcs_flow_1</bpmn:incoming>
      <bpmn:outgoing>mcs_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="maintenance-card-session-cleanup-end" name="Запуск принят">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>mcs_flow_2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="mcs_flow_1" sourceRef="maintenance-card-session-cleanup-start" targetRef="maintenance-card-session-cleanup-task" />
    <bpmn:sequenceFlow id="mcs_flow_2" sourceRef="maintenance-card-session-cleanup-task" targetRef="maintenance-card-session-cleanup-end" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_MaintenanceCard">
    <bpmndi:BPMNPlane id="BPMNPlane_MaintenanceCard" bpmnElement="maintenance-card-session-cleanup">
      <bpmndi:BPMNShape id="maintenance-card-session-cleanup-start_di" bpmnElement="maintenance-card-session-cleanup-start">
        <dc:Bounds x="120" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="maintenance-card-session-cleanup-task_di" bpmnElement="maintenance-card-session-cleanup-task">
        <dc:Bounds x="230" y="98" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="maintenance-card-session-cleanup-end_di" bpmnElement="maintenance-card-session-cleanup-end">
        <dc:Bounds x="480" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="mcs_flow_1_di" bpmnElement="mcs_flow_1">
        <di:waypoint x="156" y="138" />
        <di:waypoint x="230" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="mcs_flow_2_di" bpmnElement="mcs_flow_2">
        <di:waypoint x="400" y="138" />
        <di:waypoint x="480" y="138" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>