<?xml version='1.0' encoding='utf-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:camunda="http://camunda.org/schema/1.0/bpmn" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Labpay" targetNamespace="http://labpay.example.com/bpmn">
  <bpmn:process id="card-binding-process" name="Привязка карты" isExecutable="true" camunda:historyTimeToLive="30" camunda:candidateStarterGroups="CUSTOMER,ADMIN">
    <bpmn:startEvent id="card-binding-start" name="Старт привязки" camunda:formRef="card-binding-start" camunda:formRefBinding="deployment">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:outgoing>cb_flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="card-binding-start-task" name="Проверить карту и создать 3DS-сессию" camunda:delegateExpression="${cardBindingStartDelegate}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${camundaProcessStateListener}" />
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>cb_flow_1</bpmn:incoming>
      <bpmn:outgoing>cb_flow_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="card-binding-requires-3ds" name="Нужен 3DS?">
      <bpmn:incoming>cb_flow_2</bpmn:incoming>
      <bpmn:outgoing>cb_flow_3_yes</bpmn:outgoing>
      <bpmn:outgoing>cb_flow_3_no</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="card-binding-confirm-task" name="Подтвердить 3DS" camunda:formRef="card-binding-confirm" camunda:formRefBinding="deployment" camunda:candidateGroups="CUSTOMER,ADMIN">
      <bpmn:extensionElements>
        <camunda:taskListener event="create" delegateExpression="${camundaProcessStateListener}" />
        <camunda:taskListener event="complete" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>cb_flow_3_yes</bpmn:incoming>
      <bpmn:outgoing>cb_flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="card-binding-3ds-timeout" name="Таймаут 5 минут" attachedToRef="card-binding-confirm-task" cancelActivity="true">
      <bpmn:outgoing>cb_flow_timeout</bpmn:outgoing>
      <bpmn:timerEventDefinition>
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT5M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="card-binding-confirm-service" name="Завершить привязку карты" camunda:delegateExpression="${cardBindingConfirmDelegate}">
      <bpmn:extensionElements>
        <camunda:executionListener event="start" delegateExpression="${camundaProcessStateListener}" />
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>cb_flow_4</bpmn:incoming>
      <bpmn:outgoing>cb_flow_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="card-binding-end-no-3ds" name="Карта привязана">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>cb_flow_3_no</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="card-binding-end" name="Карта привязана">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>cb_flow_5</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="card-binding-end-timeout" name="Ошибка привязки: 3DS timeout">
      <bpmn:extensionElements>
        <camunda:executionListener event="end" delegateExpression="${camundaProcessStateListener}" />
      </bpmn:extensionElements>
      <bpmn:incoming>cb_flow_timeout</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="cb_flow_1" sourceRef="card-binding-start" targetRef="card-binding-start-task" />
    <bpmn:sequenceFlow id="cb_flow_2" sourceRef="card-binding-start-task" targetRef="card-binding-requires-3ds" />
    <bpmn:sequenceFlow id="cb_flow_3_yes" name="Да" sourceRef="card-binding-requires-3ds" targetRef="card-binding-confirm-task">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requires3ds == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="cb_flow_3_no" name="Нет" sourceRef="card-binding-requires-3ds" targetRef="card-binding-end-no-3ds">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${requires3ds == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="cb_flow_4" sourceRef="card-binding-confirm-task" targetRef="card-binding-confirm-service" />
    <bpmn:sequenceFlow id="cb_flow_5" sourceRef="card-binding-confirm-service" targetRef="card-binding-end" />
    <bpmn:sequenceFlow id="cb_flow_timeout" sourceRef="card-binding-3ds-timeout" targetRef="card-binding-end-timeout" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CardBinding">
    <bpmndi:BPMNPlane id="BPMNPlane_CardBinding" bpmnElement="card-binding-process">
      <bpmndi:BPMNShape id="card-binding-start_di" bpmnElement="card-binding-start">
        <dc:Bounds x="120" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="card-binding-start-task_di" bpmnElement="card-binding-start-task">
        <dc:Bounds x="220" y="98" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="card-binding-requires-3ds_di" bpmnElement="card-binding-requires-3ds" isMarkerVisible="true">
        <dc:Bounds x="450" y="113" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="card-binding-confirm-task_di" bpmnElement="card-binding-confirm-task">
        <dc:Bounds x="560" y="98" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="card-binding-3ds-timeout_di" bpmnElement="card-binding-3ds-timeout">
        <dc:Bounds x="640" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="card-binding-confirm-service_di" bpmnElement="card-binding-confirm-service">
        <dc:Bounds x="760" y="98" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="card-binding-end-no-3ds_di" bpmnElement="card-binding-end-no-3ds">
        <dc:Bounds x="612" y="30" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="card-binding-end_di" bpmnElement="card-binding-end">
        <dc:Bounds x="970" y="120" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="card-binding-end-timeout_di" bpmnElement="card-binding-end-timeout">
        <dc:Bounds x="970" y="210" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="cb_flow_1_di" bpmnElement="cb_flow_1">
        <di:waypoint x="156" y="138" />
        <di:waypoint x="220" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cb_flow_2_di" bpmnElement="cb_flow_2">
        <di:waypoint x="390" y="138" />
        <di:waypoint x="450" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cb_flow_3_yes_di" bpmnElement="cb_flow_3_yes">
        <di:waypoint x="500" y="138" />
        <di:waypoint x="560" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cb_flow_3_no_di" bpmnElement="cb_flow_3_no">
        <di:waypoint x="475" y="113" />
        <di:waypoint x="475" y="48" />
        <di:waypoint x="612" y="48" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cb_flow_4_di" bpmnElement="cb_flow_4">
        <di:waypoint x="700" y="138" />
        <di:waypoint x="760" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cb_flow_5_di" bpmnElement="cb_flow_5">
        <di:waypoint x="910" y="138" />
        <di:waypoint x="970" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="cb_flow_timeout_di" bpmnElement="cb_flow_timeout">
        <di:waypoint x="658" y="196" />
        <di:waypoint x="658" y="228" />
        <di:waypoint x="970" y="228" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>